{
  "title": "ecommerce-platform · Logs",
  "uid": "platform-logs",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "", "type": 1 },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG,UNKNOWN",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "correlationId",
        "label": "Correlation id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "search",
        "label": "Text search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by level",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=~\"$service\"} [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors by service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({level=\"ERROR\", service=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Top errors in the time range (grouped by stack trace fingerprint)",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(10, sum by (service, errorType, errorHash) (count_over_time({level=\"ERROR\", service=~\"$service\"} | json [$__range])))"
        }
      ],
      "transformations": [ { "id": "reduce", "options": { "reducers": [ "lastNotNull" ] } } ]
    },
    {
      "id": 4,
      "title": "Request latency p95 by service (access log)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=~\"$service\"} | json | logger=\"com.shilov.ecommerce.access\" | unwrap durationMs [$__auto]) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failed and slow requests (access log, WARN)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=\"WARN\"} | json | logger=\"com.shilov.ecommerce.access\""
        }
      ]
    },
    {
      "id": 6,
      "title": "Logs (filter by service, level, correlation id, text)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 14 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "prettifyLogMessage": false },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=~\"$level\"} | json | correlationId=~\"${correlationId:regex}.*\" |~ \"(?i)${search:regex}\""
        }
      ]
    }
  ]
}
